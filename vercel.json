{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ],
  "functions": {
    "api/financials": { "maxDuration": 15 },
    "api/peers":      { "maxDuration": 15 },
    "api/ai":         { "maxDuration": 35 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
